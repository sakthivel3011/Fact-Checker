# ==========================================================
# Fact-Checker & Daily News Digest - Environment Configuration
# ==========================================================

# LLM Provider Configuration
# Supported providers: "mock", "gemini", "openai", "groq", "ollama"
# Note: "mock" runs locally without any API keys (ideal for quick tests & grading!)
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash

# API Keys (Provide according to your selected provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Search Tools
# Tavily Search API key (Get a free key from https://app.tavily.com)
# When left blank, automatic RSS / live web scraping fallback is used.
TAVILY_API_KEY=

# Application Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=true
ENVIRONMENT=development

# Model Context Protocol (MCP) Configuration
MCP_SERVER_NAME=fact-checker-mcp
MCP_SERVER_PORT=8080

# Agentic Architecture Settings
MAX_REACT_ITERATIONS=3
CREDIBILITY_THRESHOLD=60.0
ENABLE_SAFETY_GUARDRAILS=true
ENABLE_CLICKBAIT_DETECTION=true

# RAG & Vector Storage Settings
RAG_TOP_K=4
VECTOR_STORE_PATH=./data/vector_store
KNOWLEDGE_BASE_PATH=./rag/knowledge_base.json
